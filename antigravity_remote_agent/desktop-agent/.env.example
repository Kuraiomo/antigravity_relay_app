# ──────────────────────────────────────────────────────
# Antigravity Desktop Agent — Environment Configuration
# Copy to .env and fill in values. NEVER commit .env.
# ──────────────────────────────────────────────────────

# Relay server WebSocket URL (required)
RELAY_URL=wss://remote.example.com/agent/ws

# Device enrollment token (obtained from relay admin)
ENROLLMENT_TOKEN=your-enrollment-token-here

# Stable device identifier (auto-generated on first run if blank)
DEVICE_ID=

# Agent secret — short-lived access token (auto-refreshed after enrollment)
AGENT_SECRET=

# Workspace roots — comma-separated absolute paths the agent may access
WORKSPACE_ROOTS=C:\Users\you\Projects\my-project

# Allowed commands — comma-separated command names (no arguments)
ALLOWED_COMMANDS=git status,pytest,ruff check

# Command timeout in seconds (default: 60)
COMMAND_TIMEOUT=60

# Maximum file size in bytes for file reads (default: 1048576 = 1 MB)
MAX_FILE_SIZE=1048576

# Maximum command output size in bytes (default: 524288 = 512 KB)
MAX_OUTPUT_SIZE=524288

# Log file path (default: agent.log in working directory)
LOG_FILE=agent.log

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Heartbeat interval in seconds
HEARTBEAT_INTERVAL=30

# Enable Windows startup registration (true/false, default: false)
AUTO_START=false

# Mock mode — simulate relay connection for development (true/false)
MOCK_MODE=true
