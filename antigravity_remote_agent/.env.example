# ──────────────────────────────────────────────────────
# Antigravity Remote System — Root Environment Template
# Copy to .env and fill in your values. NEVER commit .env.
# ──────────────────────────────────────────────────────

# Relay server URL
RELAY_URL=wss://your-relay-domain.com/ws/desktop
RELAY_HTTP_URL=https://your-relay-domain.com

# Device Credentials
DEVICE_ID=your-device-id
DEVICE_NAME=My Development PC
ENROLLMENT_TOKEN=your-enrollment-token
USERNAME=your-username
PASSWORD=your-secure-password

# Workspace roots (comma-separated absolute paths on Windows)
WORKSPACE_ROOTS=C:\Users\username\Projects

# Security & Commands
ALLOWED_COMMANDS=git status,pytest,ruff check
COMMAND_TIMEOUT=60
MAX_FILE_SIZE=1048576
MAX_OUTPUT_SIZE=524288

# Logging & Mode
LOG_FILE=agent.log
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL=30
MOCK_MODE=false
AUTO_LOGIN=true
