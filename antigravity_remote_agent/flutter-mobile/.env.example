# ──────────────────────────────────────────────────────
# Antigravity Flutter Mobile — Environment Example
# Copy to .env and configure for your environment.
# ──────────────────────────────────────────────────────

# Relay server URL
RELAY_URL=https://remote.example.com
RELAY_WS_URL=wss://remote.example.com/client/ws

# Device & Authentication credentials
DEVICE_ID=enrolled-device-id
DEVICE_NAME=My Development PC
ENROLLMENT_TOKEN=
USERNAME=dev-user
PASSWORD=

# Default Workspace configuration
DEFAULT_WORKSPACE_ID=C:\path\to\workspace
DEFAULT_WORKSPACE_NAME=My Project

# Mode configuration (true for mock simulation, false for live relay)
MOCK_MODE=true

# Auto-login on launch using .env credentials (true/false)
AUTO_LOGIN=true

